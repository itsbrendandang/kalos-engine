 "body_text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Scale-Up Readout</title>\n<style>\n  :root { color-scheme: light; }\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    padding: 24px 32px;\n    background: #ffffff;\n    color: #1a1f2b;\n    font-family: -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif;\n    font-size: 11px;\n    line-height: 1.3;\n  }\n  h1 { font-size: 17px; margin: 0 0 2px; }\n  h2 { font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: #5a6472; margin: 10px 0 4px; border-bottom: 1px solid #dde2e8; padding-bottom: 2px; }\n  .subtitle { color: #5a6472; margin: 0 0 2px; font-size: 10px; }\n  .timestamp { color: #8a9099; margin: 0 0 8px; font-size: 9px; }\n  .banner { padding: 7px 12px; border-radius: 4px; margin-bottom: 8px; }\n  .banner-headline { font-weight: 700; font-size: 13px; }\n  .banner-machine { font-size: 8px; letter-spacing: 0.03em; opacity: 0.7; margin-left: 6px; font-family: \"SF Mono\", Menlo, Consolas, monospace; }\n  .banner-number { background: #e5f4ea; color: #1e6b3a; border: 1px solid #b6ddc4; }\n  .banner-warning { background: #fdf3dc; color: #8a5a00; border: 1px solid #ecd39a; }\n  .banner-refusal { background: #fbe9e9; color: #a02020; border: 1px solid #eec2c2; }\n  .unused-note { margin: 4px 0 0; font-size: 9px; color: #555; }\n  .note-info { padding: 5px 12px; border-radius: 4px; margin-bottom: 8px; background: #eaf1f8; color: #1f3a52; border: 1px solid #c7d9e8; font-size: 10px; }\n  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px 16px; margin-bottom: 3px; }\n  .kv { display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px dotted #e3e6ea; padding: 1px 0; }\n  .kv .k { color: #5a6472; }\n  .kv .v { font-weight: 600; text-align: right; }\n  .kv-hash .v { font-family: \"SF Mono\", Menlo, Consolas, monospace; font-size: 7.5px; letter-spacing: -0.1px; white-space: nowrap; font-weight: 400; }\n  table { width: 100%; border-collapse: collapse; margin-bottom: 3px; }\n  table th, table td { text-align: left; padding: 2px 5px; border-bottom: 1px solid #e9ecef; font-size: 10px; }\n  table th { background: #f4f6f8; color: #444; font-weight: 600; }\n  .const-table td { padding: 2px 6px; font-size: 9px; border-bottom: 1px solid #f0f2f4; }\n  .const-table td.name { color: #5a6472; }\n  .const-table td.value { font-weight: 600; text-align: right; }\n  .reasons { margin: 3px 0 0; padding-left: 16px; }\n  .reasons li { margin-bottom: 1px; }\n  .skipped-reasons { margin: 3px 0 0; padding-left: 16px; }\n  .skipped-reasons li { margin-bottom: 1px; }\n  .data-plan { margin: 3px 0 0; padding-left: 16px; }\n  .data-plan li { margin-bottom: 1px; }\n  .muted { color: #5a6472; }\n  .provenance { margin: 0; }\n  .intended-use { margin-top: 10px; padding-top: 6px; border-top: 1px solid #dde2e8; font-size: 9px; color: #5a6472; font-style: italic; }\n  .appendix { break-before: page; page-break-before: always; margin-top: 0; }\n  .appendix h2 { margin-top: 0; }\n  .plan-json { font-family: \"SF Mono\", Menlo, Consolas, monospace; font-size: 8px; white-space: pre-wrap; word-break: break-all; background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 3px; padding: 6px; }\n  @media print {\n    /* `@page`'s margin below already reserves the page border - printing\n       the screen padding ON TOP of it would double-count the margin and\n       push content onto a second page for no reason. */\n    body { padding: 0; }\n  }\n  @page {\n    size: Letter;\n    margin: 0.4in;\n  }\n</style>\n</head>\n<body>\n<h1>Scale-Up Readout</h1>\n<p class=\"subtitle\">Kalos ScaleBridge - development decision support</p>\n<p class=\"timestamp\">Generated <timestamp> UTC</p>\n<div class=\"banner banner-number\"><span class=\"banner-headline\">Prediction issued</span><span class=\"banner-machine\">NUMBER</span></div><h2>Prediction</h2><div class=\"kv\"><span class=\"k\">Predicted titer_g_per_L at 7500 L</spa