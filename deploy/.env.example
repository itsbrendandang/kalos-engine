# kalos deployment environment: copy to `deploy/.env` and fill in.
# `.env` must NEVER be committed. Placeholders only below.
#
# compose.yaml reads `.env` automatically when you run `docker compose` from
# `deploy/` (or pass `-f deploy/compose.yaml`). Key files and the tenants map
# are NOT environment values: they are files in deploy/secrets/,
# deploy/engine-config/ and deploy/web-config/ (RUNBOOK.md, "Keys").

# ---------------------------------------------------------------------------
# Engine <-> web authentication (EdDSA engine tokens) - REQUIRED
# ---------------------------------------------------------------------------
# Key id of the Ed25519 key in deploy/secrets/engine-jwt-ed25519.pem. The
# engine's JWKS (deploy/engine-config/engine-jwks.json, printed by kalos-web's
# scripts/engine-jwks.mjs) must carry the same kid. 1-64 of [A-Za-z0-9._-].
KALOS_ENGINE_JWT_KID=kalos-web-REPLACE_ME

# Optional engine-side JWT knobs; defaults match what kalos-web mints.
# KALOS_JWT_ISSUER=kalos-web
# KALOS_JWT_AUDIENCE=kalos-engine
# KALOS_JWT_MAX_TTL_S=120
# Refuse one user or one session at once: sub:<user id>,sid:<session id>
# KALOS_AUTH_DENY_SUBJECTS=

# REQUIRED. Seeds identity pseudonyms in anonymized output
# (kalos/data/anonymizer.py). The engine refuses to start on its 0.0.0.0 bind
# without it.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KALOS_ANON_SALT=REPLACE_ME_WITH_A_RANDOM_SECRET

# ---------------------------------------------------------------------------
# Optional: service-account static tokens (scripts, CI; NOT kalos-web)
# ---------------------------------------------------------------------------
# Inline JSON array of hashed bearer tokens (kalos/portal/auth.py). Only the
# SHA-256 hash lives here. Each record names one tenant (not "default") and
# its scopes (read, write; never admin). Leave unset when only kalos-web
# talks to the engine.
#   python3 -c "import secrets, hashlib; t = secrets.token_urlsafe(32); \
#     print('token (give to the caller):', t); \
#     print('token_sha256:', hashlib.sha256(t.encode()).hexdigest())"
# KALOS_AUTH_TOKENS=[{"token_sha256":"REPLACE_ME","subject":"ci-bot","tenant":"REPLACE_ME_TENANT","scopes":["read"],"service_account":true}]

# ---------------------------------------------------------------------------
# kalos-web sign-in (Better Auth; kalos-web docs/AUTH.md) - REQUIRED
# ---------------------------------------------------------------------------
# >= 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_ME
# Public https origin users load the app from (no path).
BETTER_AUTH_URL=https://REPLACE_ME_WITH_YOUR_HOST
# Origin used in printed invitation links; defaults to BETTER_AUTH_URL.
# KALOS_PUBLIC_URL=https://kalos.example.com
# Google OAuth client ("Web application"); redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
# IP/CIDR of YOUR reverse proxy (the one that terminates TLS). "none" is
# refused in production unless AUTH_ACCEPT_NO_PROXY=1 is also set.
AUTH_TRUSTED_PROXIES=REPLACE_ME
# AUTH_ACCEPT_NO_PROXY=

# ---------------------------------------------------------------------------
# Optional: engine CORS (only for the direct-browser dev escape hatch)
# ---------------------------------------------------------------------------
# KALOS_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Host port and interface - optional
# ---------------------------------------------------------------------------
# KALOS_WEB_PORT=3000
# Default 127.0.0.1. Put a TLS-terminating reverse proxy in front for any other
# machine, and list it in AUTH_TRUSTED_PROXIES.
# KALOS_WEB_BIND=127.0.0.1
# Web proxy timeout for engine calls, ms (default 120000).
# KALOS_ENGINE_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Backup sidecar - optional
# ---------------------------------------------------------------------------
# BACKUP_KEEP_DAYS=7
# BACKUP_INTERVAL_SECONDS=86400

# ---------------------------------------------------------------------------
# Image tag - optional (upgrade/rollback, RUNBOOK.md)
# ---------------------------------------------------------------------------
# KALOS_IMAGE_TAG=local

# ---------------------------------------------------------------------------
# Optional provider credentials and sizing (kalos/providers/; offline without)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# NVIDIA_API_KEY=
# HF_TOKEN=
# KALOS_MAX_UPLOAD_MB=
# KALOS_MAX_FIT_ROWS=
# KALOS_TORCH_THREADS=
